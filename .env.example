# Copy this file to .env. Never commit your real API key.
# api = use the HTTP API below; codex = use your signed-in Codex CLI.
AI_PROVIDER=api
AI_API_KEY=API_KEY_PLACEHOLDER
# Full Chat Completions-compatible endpoint, including /chat/completions.
AI_API_URL=https://YOUR_API_HOST/v1/chat/completions
AI_MODEL=YOUR_MODEL
# Use json_schema only if your API supports strict structured outputs.
AI_JSON_MODE=json_object
